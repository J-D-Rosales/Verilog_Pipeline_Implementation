.global _start
_start:
	
# ============================================
#   FASE 4: FLOATING POINT
# ============================================

# 6. Min/Max con Infinito
    FMIN.S f13, f4, f12  # min(+Inf, 1.0) = 1.0
    FMAX.S f14, f4, f12  # max(+Inf, 1.0) = +Inf

# ============================================
#   FASE 5: FORWARDING FP
# ============================================

#Primera dependencia
FADD.S f7,  f1, f2     # 5.5
FADD.S f8,  f7, f3     # 6.5  (EX→EX forwarding)

FMUL.S f9,  f1, f2     # 7.5
FADD.S f10, f9, f3     # 8.5
FSUB.S f11, f10, f1    # 6.0